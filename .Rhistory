mutate(date = ymd(paste(year, month, day, sep = "-")),
weekday = wday(date, label = TRUE, abbr = TRUE),
week_no = week(date))
# if week_no =53, revise it to 52
station <- station %>%
mutate(week_no = ifelse(week_no == 53, 52, week_no))
weekly <- station %>%
group_by(station,year,month,week_no) %>%
summarise(
mean_temperature = round(mean(mean_temperature_c, na.rm = TRUE), 1),
minimum_temperature_c = min(minimum_temperature_c, na.rm = TRUE),
maximum_temperature_c = max(maximum_temperature_c, na.rm = TRUE),
total_rainfall = round(sum(daily_rainfall_total_mm, na.rm = TRUE),1),
highest_30_min_rainfall_mm = max(highest_30_min_rainfall_mm, na.rm = TRUE),
highest_60_min_rainfall_mm = max(highest_60_min_rainfall_mm, na.rm = TRUE),
highest_120_min_rainfall_mm = max(highest_120_min_rainfall_mm, na.rm = TRUE),
mean_wind_speed_km_h = round(mean(mean_wind_speed_km_h, na.rm=TRUE),1),
max_wind_speed = max(max_wind_speed_km_h, na.rm = TRUE),
.groups = "drop"
)
weekly <- weekly %>%
mutate(date = as.Date(paste(year, week_no, 1), format = "%Y %U %u"))
View(station)
weekly <- station %>%
group_by(station,year,month,week_no) %>%
summarise(
mean_temperature = round(mean(mean_temperature_c, na.rm = TRUE), 1),
minimum_temperature_c = min(minimum_temperature_c, na.rm = TRUE),
maximum_temperature_c = max(maximum_temperature_c, na.rm = TRUE),
total_rainfall = round(sum(daily_rainfall_total_mm, na.rm = TRUE),1),
highest_30_min_rainfall_mm = max(highest_30_min_rainfall_mm, na.rm = TRUE),
highest_60_min_rainfall_mm = max(highest_60_min_rainfall_mm, na.rm = TRUE),
highest_120_min_rainfall_mm = max(highest_120_min_rainfall_mm, na.rm = TRUE),
mean_wind_speed_km_h = round(mean(mean_wind_speed_km_h, na.rm=TRUE),1),
max_wind_speed = max(max_wind_speed_km_h, na.rm = TRUE),
.groups = "drop"
)
weekly <- weekly %>%
mutate(date = as.Date(paste(year, week_no, 1), format = "%Y %U %u"))%>%
mutate(if(weekly$max_wind_speed== -inf,NA))
monthly <- station %>%
group_by(station,year,month) %>%
summarise(
mean_temperature = round(mean(mean_temperature_c, na.rm = TRUE), 1),
minimum_temperature_c = min(minimum_temperature_c, na.rm = TRUE),
maximum_temperature_c = max(maximum_temperature_c, na.rm = TRUE),
total_rainfall = round(sum(daily_rainfall_total_mm, na.rm = TRUE),1),
highest_30_min_rainfall_mm = max(highest_30_min_rainfall_mm, na.rm = TRUE),
highest_60_min_rainfall_mm = max(highest_60_min_rainfall_mm, na.rm = TRUE),
highest_120_min_rainfall_mm = max(highest_120_min_rainfall_mm, na.rm = TRUE),
mean_wind_speed_km_h = round(mean(mean_wind_speed_km_h, na.rm=TRUE),1),
max_wind_speed = max(max_wind_speed_km_h, na.rm = TRUE),
.groups = "drop"
)
monthly <- monthly %>%
mutate(date = ymd(paste(year, month, 1, sep = "-")),
max_wind_speed = ifelse(max_wind_speed == -Inf, NA, max_wind_speed))
weekly <- station %>%
group_by(station,year,month,week_no) %>%
summarise(
mean_temperature = round(mean(mean_temperature_c, na.rm = TRUE), 1),
minimum_temperature_c = min(minimum_temperature_c, na.rm = TRUE),
maximum_temperature_c = max(maximum_temperature_c, na.rm = TRUE),
total_rainfall = round(sum(daily_rainfall_total_mm, na.rm = TRUE),1),
highest_30_min_rainfall_mm = max(highest_30_min_rainfall_mm, na.rm = TRUE),
highest_60_min_rainfall_mm = max(highest_60_min_rainfall_mm, na.rm = TRUE),
highest_120_min_rainfall_mm = max(highest_120_min_rainfall_mm, na.rm = TRUE),
mean_wind_speed_km_h = round(mean(mean_wind_speed_km_h, na.rm=TRUE),1),
max_wind_speed = max(max_wind_speed_km_h, na.rm = TRUE),
.groups = "drop"
)
weekly <- weekly %>%
mutate(date = as.Date(paste(year, week_no, 1), format = "%Y %U %u"),
max_wind_speed = ifelse(max_wind_speed == -Inf, NA, max_wind_speed))
View(weekly)
pacman::p_load(DT,sf, tmap, tidyverse,urca,tseries,plotly,ggdist,ggridges,lubridate,knitr,zoo)
gc()
gc()
