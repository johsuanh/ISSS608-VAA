time_resolution_input <- "monthly"
time_resolution_table <- switch(time_resolution_input,
daily = ts_daily_tsibble,
weekly = ts_weekly_tsibble,
monthly = ts_monthly_tsibble)
cutoff_row <- floor(0.8 * nrow(time_resolution_table))
forecasting <- time_resolution_table %>%
mutate(split = if_else(row_number() >= cutoff_row, "Hold-out", "Training"))
forecasting_train <- forecasting %>%
filter(split=="Training")
forecasting_test <- forecasting %>%
filter(split=="Hold-out")
fit_ETS <- forecasting_train %>%
model(
`WH_A` = ETS(value ~ error("A") + trend("A") + season("A")),
`WH_M` = ETS(value ~ error("M") + trend("A")  + season("M"))
)
# Compare model performance
fit_ETS %>% glance()
# Detailed report for each model
fit_ETS %>% report()# Forecast with prediction intervals
forecast_results <- fit_ETS %>%
forecast(h = 26)  # matching your original 26 months forecast
# Visualize forecasts
forecast_results %>%
autoplot(forecasting_train, level = c(95))
fit_ETS <- forecasting_train %>%
model(
# Additive Holt-Winters
`ETS_AAA` = ETS(value ~ error("A") + trend("A") + season("A")),
# Multiplicative Holt-Winters
`ETS_MAM` = ETS(value ~ error("M") + trend("A") + season("M")),
# Fully Multiplicative Model
`ETS_MMM` = ETS(value ~ error("M") + trend("M") + season("M")),
# Holt’s Linear Trend Model
`ETS_AAN` = ETS(value ~ error("A") + trend("A") + season("N")),
# Fully Multiplicative Model
`ETS_MMN` = E(value ~ error("M") + trend("M") + season("N"))
)
fit_ETS <- forecasting_train %>%
model(
# Additive Holt-Winters
`ETS_AAA` = ETS(value ~ error("A") + trend("A") + season("A")),
# Multiplicative Holt-Winters
`ETS_MAM` = ETS(value ~ error("M") + trend("A") + season("M")),
# Fully Multiplicative Model
`ETS_MMM` = ETS(value ~ error("M") + trend("M") + season("M")),
# Holt’s Linear Trend Model
`ETS_AAN` = ETS(value ~ error("A") + trend("A") + season("N")),
# Fully Multiplicative Model
`ETS_MMN` = ETS(value ~ error("M") + trend("M") + season("N"))
)
# Plot the forecast
autoplot(forecast_results, forecasting_train, level = c(95)) +
autolayer(time_resolution_table, value, color = "black") +  # Overlay actual test data
labs(title = "ETS Model Forecast vs Actual Data",
y = "Value",
x = "Time") +
theme_minimal()
fit_autoETS <- forecasting_train %>%
model(ETS(value))
fit_autoETS %>% report()
forecast_results <- fit_autoETS %>%
forecast(h = 26)  # matching your original 26 months forecast
# Visualize forecasts
forecast_results %>%
autoplot(forecasting, level = NULL)
residuals_ets <- residuals(fit_ETS)
# Plot residuals
plot(residuals_ets, main = "Residuals of ETS Model")
# ACF of residuals
acf(residuals_ets, main = "ACF of Residuals of ETS Model")
