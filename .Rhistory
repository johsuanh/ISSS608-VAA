pacman::p_load(sf, tmap, tidyverse, knitr)
mpsz <- st_read(dsn="data/geospatial",
layer ="MP14_SUBZONE_WEB_PL")
#| echo: false
kable(head(mpsz))
popdata <- read_csv("data/aspatial/respopagesextod2011to2020.csv")
summary(popdata)
popdata2020 <- popdata %>%
filter(Time==2020) %>%
group_by(PA,SZ,AG) %>%
summarise(`POP`=sum(`Pop`)) %>%
ungroup() %>%
pivot_wider(names_from = AG,
values_from = POP) %>%
mutate(YOUNG = rowSums(.[3:6])+rowSums(.[12]),
ECONOMY_ACTIVE = rowSums(.[7:11])+rowSums(.[13:15]),
AGED=rowSums(.[16:21]),
TOTAL=rowSums(.[3:21]),
DEPENDENCY = ((YOUNG+AGED)/ECONOMY_ACTIVE)) %>%
select(PA,SZ,YOUNG,AGED,ECONOMY_ACTIVE,TOTAL,DEPENDENCY)
#| echo: true
popdata2020 <- popdata2020 %>%
mutate_at(.vars = vars(PA, SZ),
.funs = funs(toupper)) %>% #To uppercase
filter(ECONOMY_ACTIVE > 0) #filter out NA data
mpsz_pop2020 <- left_join(mpsz, popdata2020,
by = c("SUBZONE_N" = "SZ"))
#| echo: false
kable(head(mpsz_pop2020))
View(mpsz_pop2020)
#| fig-width: 12
tmap_mode("view")
youngmap <- tm_shape(mpsz_pop2020)+
tm_polygons("YOUNG",
style = "quantile",
palette = "Blues",
legend.frame = FALSE,
bg.color = "#f3f1e9",
frame=FALSE,
id = "SUBZONE_N")
agedmap <- tm_shape(mpsz_pop2020)+
tm_polygons("AGED",
style = "quantile",
palette = "Blues",
legend.frame = FALSE,
bg.color = "#f3f1e9",
frame=FALSE,
id = "SUBZONE_N")
tmap_arrange(youngmap, agedmap, asp=1, ncol=2)
#| fig-width: 12
tmap_mode("view")
